# Environment

# Cloudflare R2 (S3-compatible) credentials for WALrus.
# Note: URL may embed the bucket in the path; walrusd strips it and uses
# WALRUS_STORAGE_BUCKET for the bucket.

URL=https://<account-id>.r2.cloudflarestorage.com/<bucket>
ACCESS_KEY_ID=<access-key-id>
SECRET_ACCESS_KEY=<secret-access-key>

# For walrusd, export:
#   export WALRUS_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   export WALRUS_STORAGE_BUCKET="<bucket>"
#   export WALRUS_STORAGE_ACCESS_KEY_ID="$ACCESS_KEY_ID"
#   export WALRUS_STORAGE_SECRET_ACCESS_KEY="$SECRET_ACCESS_KEY"
#   export WALRUS_WORKER_ID="writer-1"
