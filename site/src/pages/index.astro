---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { landingCopy } from "../data/landing";
---

<StarlightPage
  frontmatter={{
    title: landingCopy.meta.title,
    description: landingCopy.meta.description,
    template: "splash",
  }}
  hasSidebar={false}
>
  <script is:inline>
    if (
      "IntersectionObserver" in window &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      document.documentElement.classList.add("landing-reveal-ready");
    }
  </script>

  <div class="landing">
    <section class="hero">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-content">
        <div class="hero-text">
          <p class="pill">
            <span class="dot" aria-hidden="true"></span>
            {landingCopy.hero.eyebrow}
          </p>
          <h1 class="display">
            {landingCopy.hero.title}<span class="cursor" aria-hidden="true"></span>
          </h1>
          <p class="hero-expansion">{landingCopy.hero.expansion}</p>
          <p class="hero-body">{landingCopy.hero.description}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={landingCopy.hero.primaryAction.href}>
              {landingCopy.hero.primaryAction.label}
              <span aria-hidden="true">-&gt;</span>
            </a>
            <a
              class="btn"
              href={landingCopy.hero.secondaryAction.href}
              rel="noreferrer"
            >
              {landingCopy.hero.secondaryAction.label}
            </a>
          </div>
        </div>

        <div class="hero-meta" aria-label={landingCopy.hero.eyebrow}>
          {
            landingCopy.hero.terminal.map((line) => (
              <p>
                {line.prompt && <span class="prompt">{line.prompt}</span>}
                {line.output && <span class="output">{line.output}</span>}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <div class="ticker" role="region" aria-label={landingCopy.hero.factsLabel}>
      <div class="ticker-track">
        <div class="ticker-group">
          {
            landingCopy.hero.ticker.map((fact) => (
              <span class="ticker-item">
                <span class="val">{fact}</span>
              </span>
            ))
          }
        </div>
        <div class="ticker-group" aria-hidden="true">
          {
            landingCopy.hero.ticker.map((fact) => (
              <span class="ticker-item">{fact}</span>
            ))
          }
        </div>
      </div>
    </div>

    <section class="properties-section" aria-label={landingCopy.capabilities.eyebrow}>
      <div class="container">
        <div class="status-grid reveal">
          {
            landingCopy.hero.status.map((item) => (
              <article class="status-cell">
                <p class="status-cell-label">{item.label}</p>
                <p class="status-cell-value">{item.value}</p>
                <p class="status-cell-delta">{item.detail}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container">
        <header class="section-head reveal">
          <span class="ghost-word" aria-hidden="true">{landingCopy.architecture.ghost}</span>
          <p class="label">{landingCopy.architecture.eyebrow}</p>
          <h2>{landingCopy.architecture.title}</h2>
          <p>{landingCopy.architecture.intro}</p>
        </header>

        <div class="arch-wrap">
          <div class="arch-layers-list reveal">
            {
              landingCopy.architecture.stages.map((stage, index) => (
                <article class="arch-card" style={`--stage-index: ${index}`}>
                  <div class="arch-card-top">
                    <span class="arch-card-idx">{stage.number}</span>
                    <h3 class="arch-card-title">{stage.title}</h3>
                  </div>
                  <p class="arch-card-desc">{stage.body}</p>
                </article>
              ))
            }
          </div>

          <div class="iso-scene reveal" aria-hidden="true">
            <div class="iso-stack">
              <div class="iso-base"></div>
              {
                landingCopy.architecture.stages.map((stage, index) => (
                  <div
                    class="iso-plate"
                    style={`--z: ${(index - 2) * 44}px; --plate-index: ${index}`}
                  >
                    {Array.from({ length: 18 }).map(() => <span class="chip"></span>)}
                  </div>
                ))
              }
              <span class="iso-packet p1"></span>
              <span class="iso-packet p2"></span>
            </div>
            <span class="iso-tag iso-tag-in">
              <span class="val">{landingCopy.architecture.hud.input}</span>
            </span>
            <span class="iso-tag iso-tag-out">
              <span class="val">{landingCopy.architecture.hud.output}</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad section-raised">
      <div class="container">
        <header class="section-head reveal">
          <p class="label">{landingCopy.writePath.eyebrow}</p>
          <h2>{landingCopy.writePath.title}</h2>
          <p>{landingCopy.writePath.intro}</p>
        </header>

        <ol class="write-path reveal">
          {
            landingCopy.writePath.steps.map((step) => (
              <li class="write-step">
                <span class="write-step-number">{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="privacy-grid">
          <article class="privacy-cell reveal">
            <p class="privacy-cell-value">{landingCopy.writePath.ack.value}</p>
            <h3 class="privacy-cell-label">{landingCopy.writePath.ack.label}</h3>
            <p class="privacy-cell-title">{landingCopy.writePath.ack.title}</p>
            <p class="privacy-cell-desc">{landingCopy.writePath.ack.body}</p>
          </article>
          <article class="privacy-cell reveal">
            <p class="privacy-cell-value">{landingCopy.writePath.read.value}</p>
            <h3 class="privacy-cell-label">{landingCopy.writePath.read.label}</h3>
            <p class="privacy-cell-title">{landingCopy.writePath.read.title}</p>
            <p class="privacy-cell-desc">{landingCopy.writePath.read.body}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container">
        <header class="section-head reveal">
          <p class="label">{landingCopy.capabilities.eyebrow}</p>
          <h2>{landingCopy.capabilities.title}</h2>
          <p>{landingCopy.capabilities.intro}</p>
        </header>

        <div class="cap-grid">
          {
            landingCopy.capabilities.cards.map((card, index) => (
              <article class:list={["cap-item", "reveal", { wide: index === 0 }]}>
                <p class="cap-item-kicker">{card.kicker}</p>
                <div class="cap-item-header">
                  <span class="cap-item-led" aria-hidden="true"></span>
                  <h3 class="cap-item-title">{card.title}</h3>
                </div>
                <p class="cap-item-desc">{card.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad section-raised">
      <div class="container quickstart-layout">
        <header class="section-head reveal">
          <p class="label">{landingCopy.quickstart.eyebrow}</p>
          <h2>{landingCopy.quickstart.title}</h2>
          <p>{landingCopy.quickstart.intro}</p>
        </header>

        <div class="code-panel corners reveal">
          <div class="chart-header" aria-hidden="true">
            <span class="chart-title">
              <span class="dot"></span>
              {landingCopy.quickstart.filename}
            </span>
            <span class="chart-value">{landingCopy.quickstart.status}</span>
          </div>
          <Code code={landingCopy.quickstart.code} lang="ts" />
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container cta-inner reveal">
        <p class="cta-prompt">
          <span class="prompt" aria-hidden="true">$</span>
          <span>{landingCopy.closing.prompt.replace("$ ", "")}</span>
          <span class="cursor" aria-hidden="true"></span>
        </p>
        <p class="label">{landingCopy.closing.eyebrow}</p>
        <h2 class="cta-title">{landingCopy.closing.title}</h2>
        <p class="cta-desc">{landingCopy.closing.body}</p>
        <a class="btn btn-primary" href={landingCopy.closing.action.href}>
          {landingCopy.closing.action.label}
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </section>

    <footer class="footer">
      <div class="container footer-inner">
        <span class="footer-brand">{landingCopy.hero.title}</span>
        <span class="footer-copy">{landingCopy.meta.description}</span>
      </div>
    </footer>
  </div>

  <script is:inline>
    (() => {
      if (!document.documentElement.classList.contains("landing-reveal-ready")) return;

      const items = Array.from(document.querySelectorAll(".landing .reveal"));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
      );

      for (const item of items) observer.observe(item);
    })();
  </script>
</StarlightPage>

<style>
  :global(body:has(.landing) .main-frame) {
    padding-inline-start: 0;
  }

  :global(body:has(.landing) main) {
    padding: 0;
  }

  :global(body:has(.landing) main > .content-panel) {
    padding: 0;
    border-top: 0;
  }

  :global(body:has(.landing) main > .content-panel > .sl-container) {
    max-width: none;
    margin-inline: 0;
  }

  :global(body:has(.landing) main > .content-panel:first-child) {
    display: none;
  }

  .landing {
    min-height: 100vh;
    overflow: hidden;
    color: var(--fg);
    background: var(--bg);
  }

  .container {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(90% 80% at 50% 40%, black 30%, transparent 100%);
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 900px;
    max-height: 900px;
    pointer-events: none;
    background: radial-gradient(
      circle,
      rgba(52, 211, 153, 0.13) 0%,
      rgba(52, 211, 153, 0.04) 40%,
      transparent 70%
    );
    animation: glow-pulse 8s ease-in-out infinite;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
    padding-block: clamp(84px, 10vw, 132px) clamp(66px, 8vw, 100px);
  }

  .hero-text {
    position: relative;
    z-index: 2;
    max-width: 650px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pill .dot,
  .chart-title .dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
    animation: led-blink 2.4s ease-in-out infinite;
  }

  .display {
    margin: 26px 0 20px;
    color: var(--fg);
    font-size: clamp(44px, 7vw, 92px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .cursor {
    display: inline-block;
    width: 4px;
    height: 0.82em;
    margin-left: 7px;
    vertical-align: text-bottom;
    background: var(--accent-green);
    box-shadow: 0 0 12px var(--accent-green);
    animation: cursor-blink 1.1s step-end infinite;
  }

  .hero-expansion {
    max-width: 560px;
    color: var(--fg);
    font-size: clamp(19px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .hero-body {
    max-width: 500px;
    margin-top: 18px;
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.18s var(--ease-out),
      background 0.18s var(--ease-out),
      border-color 0.18s var(--ease-out),
      box-shadow 0.18s var(--ease-out);
  }

  .btn:hover {
    border-color: var(--border-hover);
    background: rgba(255, 255, 255, 0.04);
  }

  .btn-primary {
    border-color: var(--accent-green);
    color: #000000;
    background: var(--accent-green);
    font-weight: 600;
  }

  .btn-primary:hover {
    border-color: var(--accent-green-bright);
    color: #000000;
    background: var(--accent-green-bright);
    box-shadow: 0 0 32px rgba(52, 211, 153, 0.35);
  }

  .hero-meta {
    position: relative;
    z-index: 2;
    min-width: 0;
    max-width: 100%;
    padding-left: 16px;
    border-left: 2px solid var(--border);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.9;
    font-variant-numeric: tabular-nums;
    overflow-x: auto;
  }

  .hero-meta p {
    margin: 0;
    white-space: nowrap;
  }

  .hero-meta .prompt {
    color: var(--accent-green);
  }

  .hero-meta .output {
    display: block;
    color: var(--fg-muted);
  }

  .ticker {
    overflow: hidden;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 36s linear infinite;
  }

  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }

  .ticker-group {
    display: flex;
  }

  .ticker-item {
    display: flex;
    align-items: center;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ticker-item::after {
    content: "//";
    margin: 0 28px;
    color: rgba(52, 211, 153, 0.25);
  }

  .ticker-item .val {
    color: var(--accent-green);
  }

  .properties-section {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
  }

  .status-cell {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px;
    background: var(--bg);
    transition: background 0.25s;
  }

  .status-cell:hover {
    background: var(--bg-elevated);
  }

  .status-cell-label,
  .cap-item-kicker {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-cell-value {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: clamp(20px, 2.2vw, 24px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .status-cell-delta {
    color: var(--accent-green);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
  }

  .section-pad {
    position: relative;
    padding: clamp(72px, 10vw, 128px) 0;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .section-raised {
    background:
      linear-gradient(180deg, rgba(7, 10, 8, 0.84), rgba(0, 0, 0, 0.36)),
      var(--bg);
  }

  .section-head {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .section-head .label {
    display: block;
    margin-bottom: 14px;
  }

  .label {
    color: var(--accent-green);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-head h2,
  .cta h2 {
    color: var(--fg);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .section-head > p:last-child {
    max-width: 560px;
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .ghost-word {
    position: absolute;
    top: -0.35em;
    left: -0.05em;
    z-index: -1;
    color: transparent;
    font-size: clamp(72px, 12vw, 160px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.05);
  }

  .arch-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  .arch-layers-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .arch-card {
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    transition:
      border-color 0.25s,
      background 0.25s,
      transform 0.25s var(--ease-out);
  }

  .arch-card:not(:hover) {
    animation: arch-card-cycle 20s linear infinite;
    animation-delay: calc(var(--stage-index) * 4s);
  }

  .arch-card:hover {
    border-color: var(--green-dim);
    background: var(--bg-elevated);
    transform: translateX(6px);
  }

  .arch-card-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .arch-card-idx {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .arch-card-title {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .arch-card:not(:hover) .arch-card-title {
    animation: arch-card-title-cycle 20s linear infinite;
    animation-delay: calc(var(--stage-index) * 4s);
  }

  .arch-card:hover .arch-card-title {
    color: var(--accent-green);
  }

  .arch-card-desc {
    color: var(--fg-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .iso-scene {
    position: relative;
    height: 480px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 62%,
        rgba(52, 211, 153, 0.07),
        transparent 70%
      ),
      var(--bg-elevated);
    perspective: 1400px;
  }

  .iso-stack {
    position: absolute;
    top: 46%;
    left: 50%;
    width: 240px;
    height: 240px;
    margin: -120px 0 0 -120px;
    transform: rotateX(58deg) rotateZ(-42deg);
    transform-style: preserve-3d;
  }

  .iso-plate {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--border-hover);
    border-radius: 4px;
    background: rgba(10, 13, 11, 0.92);
    transform: translateZ(var(--z));
    transition:
      transform 0.45s var(--ease-out),
      border-color 0.3s,
      box-shadow 0.3s;
    animation: iso-plate-cycle 20s linear infinite;
    animation-delay: calc(var(--plate-index) * 4s);
  }

  .iso-plate .chip {
    border: 1px solid var(--border);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.05);
    transition:
      background 0.3s,
      border-color 0.3s;
    animation: iso-chip-cycle 20s linear infinite;
    animation-delay: calc(var(--plate-index) * 4s);
  }

  .iso-base {
    position: absolute;
    inset: -24px;
    border: 1px solid var(--green-dim);
    border-radius: 8px;
    background: rgba(52, 211, 153, 0.1);
    filter: blur(1px);
    transform: translateZ(-70px);
  }

  .iso-packet {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    opacity: 0;
    background: var(--accent-green-bright);
    box-shadow: 0 0 12px var(--accent-green);
    transform: translateZ(-80px);
  }

  .iso-packet.p1 {
    animation: packet-drop 3.2s linear infinite;
  }

  .iso-packet.p2 {
    animation: packet-drop 3.2s linear 1.6s infinite;
  }

  .iso-tag {
    position: absolute;
    z-index: 2;
    color: var(--fg-dim);
